---
import ImageUpload from './ImageUpload.astro';
import MarkdownEditor from './MarkdownEditor.astro';
---

<form id="note-form" novalidate>
  <div class="note-metadata">
  <div id="note-error-summary" class="error-summary" role="alert" tabindex="-1" hidden>
    <h3>Revisa el borrador</h3>
    <ul></ul>
  </div>
  <div class="note-heading">
    <div>
      <p class="eyebrow">Nota</p>
      <h2 id="note-form-heading">Nueva nota</h2>
    </div>
    <span class="dirty-badge" id="dirty-badge" hidden>Sin guardar</span>
  </div>
  <div class="field title-field"><label for="note-title">Título</label><input id="note-title" name="title" required autocomplete="off" placeholder="Título de la nota" /><p class="field-error" data-error-for="title"></p></div>
  <details class="settings-disclosure" id="note-settings">
    <summary>Ajustes de la nota <span>Descripción, clasificación y formato</span></summary>
    <div class="form-grid">
    <div class="field"><label for="note-id">ID del archivo</label><input id="note-id" name="id" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" autocomplete="off" /><p class="field-help">Puedes corregirlo antes del primer guardado.</p><p class="field-error" data-error-for="id"></p></div>
    <div class="field"><label for="note-duration">Duración (minutos)</label><input id="note-duration" name="durationMinutes" type="number" min="1" step="1" value="5" required /><p class="field-error" data-error-for="durationMinutes"></p></div>
    <div class="field span-2"><label for="note-description">Descripción</label><textarea id="note-description" name="description" rows="3" required></textarea><p class="field-error" data-error-for="description"></p></div>
    <div class="field"><label for="note-category">Categoría</label><select id="note-category" name="category" required><option value="">Selecciona…</option></select><p class="field-error" data-error-for="category"></p></div>
    <div class="field"><label for="note-topic">Tema (opcional)</label><select id="note-topic" name="topic"><option value="">Sin tema</option></select><p class="field-error" data-error-for="topic"></p></div>
    <div class="field"><label for="note-position">Posición global</label><input id="note-position" name="position" type="number" min="1" step="1" value="1" required /><p class="field-error" data-error-for="position"></p></div>
    <div class="field"><label for="note-format">Formato</label><select id="note-format" name="format"><option value="written">Escrita</option><option value="video">Video</option></select></div>
    <div class="field span-2"><label for="note-tags">Etiquetas</label><input id="note-tags" name="tags" list="existing-tags" placeholder="dart, tipos" required /><datalist id="existing-tags"></datalist><p class="field-help">Separa varias etiquetas con comas. Puedes escribir una nueva.</p><p class="field-error" data-error-for="tags"></p></div>
    <div class="field span-2" id="video-fields" hidden><label for="youtube-video-id">ID de YouTube</label><input id="youtube-video-id" name="youtubeVideoId" maxlength="11" autocomplete="off" /><p class="field-error" data-error-for="youtubeVideoId"></p></div>
    </div>
    <ImageUpload />
  </details>
  </div>
  <MarkdownEditor />
  <div class="button-row"><button type="button" id="trash-note" class="danger" hidden>Mover a papelera</button></div>
</form>
