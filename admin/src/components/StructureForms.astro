<section id="structure-workspace" class="workspace-view" hidden aria-labelledby="structure-heading">
  <div class="form-heading">
    <div><p class="eyebrow">Estructura editorial</p><h2 id="structure-heading">Categorías y temas</h2></div>
  </div>
  <div class="structure-grid">
    <form id="category-form" class="subpanel" novalidate>
      <h3>Categoría</h3>
      <label for="category-existing">Editar existente</label>
      <select id="category-existing" name="existing"><option value="">Nueva categoría</option></select>
      <label for="category-id">ID estable</label><input id="category-id" name="id" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" />
      <label for="category-name">Nombre</label><input id="category-name" name="name" required />
      <label for="category-description">Descripción</label><textarea id="category-description" name="description" required></textarea>
      <label for="category-image">Imagen</label><input id="category-image" name="image" value="/images/categories/" required />
      <label for="category-level">Nivel</label><select id="category-level" name="level"><option value="beginner">Principiante</option><option value="intermediate">Intermedio</option><option value="advanced">Avanzado</option><option value="pro">Pro</option></select>
      <div class="button-row"><button type="submit">Guardar categoría</button><button type="button" id="delete-category" class="danger" hidden>Eliminar categoría</button></div>
    </form>
    <form id="topic-form" class="subpanel" novalidate>
      <h3>Tema</h3>
      <label for="topic-category">Categoría</label><select id="topic-category" name="category" required><option value="">Selecciona…</option></select>
      <label for="topic-existing">Editar existente</label><select id="topic-existing" name="existing"><option value="">Nuevo tema</option></select>
      <label for="topic-id">ID estable</label><input id="topic-id" name="id" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" />
      <label for="topic-name">Nombre</label><input id="topic-name" name="name" required />
      <label for="topic-position">Posición global</label><input id="topic-position" name="position" type="number" min="1" step="1" required />
      <div class="button-row"><button type="submit">Guardar tema</button><button type="button" id="delete-topic" class="danger" hidden>Eliminar tema</button></div>
    </form>
  </div>
</section>
