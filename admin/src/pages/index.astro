---
import { Eye, FilePenLine, Maximize2, Menu, Minimize2, Save, Trash, TriangleAlert } from '@lucide/astro';
import AdminLayout from '../layouts/AdminLayout.astro';
import ContentExplorer from '../components/ContentExplorer.astro';
import ContentOutline from '../components/ContentOutline.astro';
import NoteForm from '../components/NoteForm.astro';
import NotePreview from '../components/NotePreview.astro';
import StructureForms from '../components/StructureForms.astro';
import TrashPanel from '../components/TrashPanel.astro';
---

<AdminLayout>
  <div slot="explorer"><ContentExplorer /></div>
  <p id="admin-status" role="status">Conectando con los archivos del repositorio…</p>
  <div id="admin-error" class="error-state" role="alert" hidden></div>

  <section class="category-workspace" aria-labelledby="active-category-name">
    <header class="workspace-header">
      <button type="button" id="mobile-back" class="icon-button mobile-only" aria-label="Volver a categorías"><Menu aria-hidden="true" /></button>
      <div class="category-title-field">
        <p>Categoría seleccionada</p>
        <h2 id="active-category-name">Selecciona una categoría</h2>
      </div>
      <div class="workspace-actions" role="group" aria-label="Acciones de la categoría">
        <button type="button" data-workspace="note" class="secondary-action">Nota</button>
        <button type="button" data-workspace="order" class="secondary-action">Orden</button>
        <button type="button" data-workspace="trash" class="icon-button" aria-label="Abrir papelera" title="Papelera"><Trash aria-hidden="true" /></button>
      </div>
    </header>

    <div class="workspace-grid">
      <ContentOutline />
      <section class="content-panel">
        <div class="editor-toolbar">
          <div class="editor-toolbar-start">
            <div class="view-switcher" role="group" aria-label="Vista de la nota">
              <button type="button" id="show-editor" aria-pressed="true"><FilePenLine aria-hidden="true" /> Editor</button>
              <button type="button" id="show-preview" aria-pressed="false"><Eye aria-hidden="true" /> Vista previa</button>
            </div>
            <div class="focus-heading" hidden>
              <span>Escribiendo</span>
              <strong id="focus-note-title">Nueva nota</strong>
              <span class="dirty-badge" id="focus-dirty-badge" hidden>Sin guardar</span>
            </div>
          </div>
          <div class="editor-toolbar-actions">
            <button type="button" id="toggle-focus" class="secondary-action" aria-pressed="false">
              <Maximize2 aria-hidden="true" data-focus-icon="enter" />
              <Minimize2 aria-hidden="true" data-focus-icon="exit" class="focus-icon-hidden" />
              <span data-focus-label>Modo enfoque</span>
            </button>
            <button id="save-note" class="primary-action" type="submit" form="note-form" disabled><Save aria-hidden="true" /> Guardar nota</button>
          </div>
        </div>
        <div id="note-layout" class="note-layout">
          <section id="note-workspace" class="workspace-view"><NoteForm /></section>
          <section id="preview-workspace" class="workspace-view preview-workspace" hidden><NotePreview /></section>
        </div>
        <StructureForms />
        <TrashPanel />
        <section id="empty-workspace" class="empty-workspace" hidden>
          <TriangleAlert aria-hidden="true" />
          <h2>Selecciona una categoría</h2>
          <p>Elige una categoría de la biblioteca o crea una nueva para comenzar.</p>
        </section>
      </section>
    </div>
  </section>

  <dialog id="unsaved-dialog" aria-labelledby="unsaved-title">
    <h2 id="unsaved-title">Tienes cambios sin guardar</h2>
    <p>Puedes seguir editando o descartar el borrador antes de cambiar de elemento.</p>
    <div class="button-row"><button type="button" data-unsaved-stay>Seguir editando</button><button type="button" data-unsaved-discard class="danger">Descartar cambios</button></div>
  </dialog>
</AdminLayout>

<script src="../lib/client/admin-app.ts"></script>
<script src="../lib/client/category-panel.ts"></script>
<script src="../lib/client/structure-app.ts"></script>
<script src="../lib/client/trash-app.ts"></script>
