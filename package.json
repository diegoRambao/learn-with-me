{
  "name": "learn-diego-rambao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node --import tsx scripts/validate-content.ts",
