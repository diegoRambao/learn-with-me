---
import { ArrowRight } from '@lucide/astro';
import { levelLabels, type Category } from '@lib/content';
import { categoryUrl } from '@lib/routes';
interface Props { category: Category; destination?: string; headingLevel?: 'h2' | 'h3' }
const { category, destination = categoryUrl(category.id), headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class="interactive-card category-card panel overflow-hidden" data-level={category.level} data-category-id={category.id}>
  <a class="block h-full no-underline" href={destination}>
    <div class="aspect-video overflow-hidden border-b border-line bg-ink-800">
      <img src={category.image} alt={`Ilustración de ${category.name}`} width="800" height="450" loading="lazy" class="h-full w-full object-cover" data-category-image />
    </div>
    <div class="p-5">
      <span class="inline-flex rounded-full border border-line px-3 py-1 text-xs font-bold text-accent">{levelLabels[category.level]}</span>
      <Heading class="mt-5 text-xl font-bold">{category.name}</Heading>
      <p class="mt-2 inline-flex items-center gap-2 text-sm text-muted">Explorar ruta <ArrowRight aria-hidden="true" class="ui-icon" /></p>
    </div>
  </a>
</article>

<script>
  for (const image of document.querySelectorAll<HTMLImageElement>('[data-category-image]')) {
    image.addEventListener('error', () => {
      image.src = '/category-fallback.svg';
    }, { once: true });
  }
</script>
