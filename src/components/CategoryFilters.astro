---
import { levelLabels, categoryLevels } from '@lib/content';
interface Props { total: number }
const { total } = Astro.props;
---

<section aria-labelledby="filter-title" data-category-filters>
  <h2 id="filter-title" class="sr-only">Filtrar por nivel</h2>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Nivel de complejidad">
    <button class="filter-button" type="button" data-filter="all" aria-pressed="true">Todos</button>
    {categoryLevels.map((level) => <button class="filter-button" type="button" data-filter={level} aria-pressed="false">{levelLabels[level]}</button>)}
  </div>
  <p class="mt-5 text-sm text-muted"><span data-matching-count>{total}</span> <span data-count-label>{total === 1 ? 'categoría visible' : 'categorías visibles'}</span></p>
  <p class="sr-only" aria-live="polite" data-filter-announcement></p>
</section>

<script>
  const initializeCategoryFilters = () => {
    const root = document.querySelector<HTMLElement>('[data-category-filters]');
    if (!root) return;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('article[data-level]')];
    const empty = document.querySelector<HTMLElement>('[data-no-matches]');
    const count = root.querySelector<HTMLElement>('[data-matching-count]');
    const label = root.querySelector<HTMLElement>('[data-count-label]');
    const announcement = root.querySelector<HTMLElement>('[data-filter-announcement]');

    const applyFilter = (selectedLevel: string) => {
      let matchingCount = 0;
      for (const card of cards) {
        const matches = selectedLevel === 'all' || card.dataset.level === selectedLevel;
        card.hidden = !matches;
        if (matches) matchingCount += 1;
      }
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.filter === selectedLevel));
      if (count) count.textContent = String(matchingCount);
      if (label) label.textContent = matchingCount === 1 ? 'categoría visible' : 'categorías visibles';
      if (announcement) announcement.textContent = `Filtro actualizado: ${matchingCount} ${matchingCount === 1 ? 'categoría visible' : 'categorías visibles'}.`;
      if (empty) empty.hidden = matchingCount > 0;
    };

    for (const button of buttons) button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
    document.querySelector('[data-show-all]')?.addEventListener('click', () => applyFilter('all'));
  };

  initializeCategoryFilters();
</script>

<style>
  .filter-button { min-height: 2.75rem; border: 1px solid var(--border-color); border-radius: 999px; padding: .55rem 1rem; background: var(--surface-background); color: var(--text-primary); cursor: pointer; font-weight: 700; }
  .filter-button:hover { border-color: var(--accent-color); background: var(--interactive-hover); }
  .filter-button[aria-pressed="true"] { border-color: var(--accent-color); background: var(--interactive-active); color: var(--interactive-active-text); box-shadow: inset 0 0 0 1px var(--accent-color); }
</style>
