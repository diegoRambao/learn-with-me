---
import type { Note } from '@lib/content';
interface Props { note: Note; Content?: any }
const { note, Content } = Astro.props;
const watchUrl = note.format === 'video' ? `https://www.youtube.com/watch?v=${note.youtubeVideoId}` : '';
const embedUrl = note.format === 'video' ? `https://www.youtube.com/embed/${note.youtubeVideoId}` : '';
---

<article aria-labelledby="note-title">
  <p class="eyebrow">Clase {note.position} · {note.durationMinutes} minutos</p>
  <h1 id="note-title" class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{note.title}</h1>
  <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{note.description}</p>

  {note.format === 'written' ? (
    <div class="note-prose mt-10 border-t border-line pt-8">
      {Content ? <Content /> : <p>Este contenido no se pudo mostrar. Vuelve a la ruta e intenta otra nota.</p>}
    </div>
  ) : (
    <section aria-label={`Video: ${note.title}`} class="mt-10">
      <div class="video-frame aspect-video overflow-hidden rounded-2xl border border-line">
        <iframe class="h-full w-full" src={embedUrl} title={`Video: ${note.title}`} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
      <p class="mt-4 text-sm text-muted">Si el reproductor no está disponible, <a class="font-bold text-accent underline underline-offset-4" href={watchUrl}>abre “{note.title}” directamente en YouTube</a>.</p>
    </section>
  )}
</article>

<script>
  const selectCodeForManualCopy = (code: HTMLElement): void => {
    const selection = window.getSelection();
    if (!selection) return;

    const range = document.createRange();
    range.selectNodeContents(code);
    selection.removeAllRanges();
    selection.addRange(range);
  };

  const enhanceCodeBlock = (code: HTMLElement): void => {
    const preformattedBlock = code.parentElement;
    if (!(preformattedBlock instanceof HTMLPreElement) || preformattedBlock.parentElement?.classList.contains('code-block')) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const button = document.createElement('button');
    button.className = 'code-copy-button';
    button.type = 'button';
    button.textContent = 'Copiar';
    button.setAttribute('aria-label', 'Copiar bloque de código');
    const status = document.createElement('p');
    status.className = 'code-copy-status';
    status.setAttribute('aria-live', 'polite');

    preformattedBlock.before(wrapper);
    wrapper.append(button, status, preformattedBlock);

    let resetTimer: number | undefined;
    const showStatus = (message: string, state: 'copied' | 'error'): void => {
      window.clearTimeout(resetTimer);
      wrapper.dataset.copyState = state;
      status.textContent = message;
      if (state === 'copied') {
        resetTimer = window.setTimeout(() => {
          wrapper.dataset.copyState = 'idle';
          status.textContent = '';
        }, 2400);
      }
    };

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(code.textContent ?? '');
        showStatus('Código copiado.', 'copied');
      } catch {
        selectCodeForManualCopy(code);
        showStatus('No se pudo copiar automáticamente. El código quedó seleccionado para copiarlo manualmente.', 'error');
      }
    });
  };

  document.querySelectorAll<HTMLElement>('.note-prose pre > code').forEach(enhanceCodeBlock);
</script>
