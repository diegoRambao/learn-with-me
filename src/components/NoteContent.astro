---
import { Copy, X } from '@lucide/astro';
import type { Note } from '@lib/content';
interface Props { note: Note; Content?: any }
const { note, Content } = Astro.props;
const watchUrl = note.format === 'video' ? `https://www.youtube.com/watch?v=${note.youtubeVideoId}` : '';
const embedUrl = note.format === 'video' ? `https://www.youtube.com/embed/${note.youtubeVideoId}` : '';
---

<article class="note-content" aria-labelledby="note-title">
  <p class="eyebrow">Clase {note.position} · {note.durationMinutes} minutos</p>
  <h1 id="note-title" class="note-content-title">{note.title}</h1>
  <p class="note-content-description">{note.description}</p>

  {note.format === 'written' ? (
    <>
      <div class="note-prose note-content-body">
        {Content ? <Content /> : <p>Este contenido no se pudo mostrar. Vuelve a la ruta e intenta otra nota.</p>}
      </div>
      <dialog class="note-image-dialog" data-note-image-dialog aria-label="Vista ampliada de imagen">
        <button class="note-image-dialog-close" type="button" aria-label="Cerrar imagen ampliada" data-note-image-close>
          <X aria-hidden="true" class="ui-icon" />
        </button>
        <figure class="note-image-dialog-figure">
          <img alt="" data-note-image-preview />
          <figcaption data-note-image-caption hidden></figcaption>
        </figure>
      </dialog>
    </>
  ) : (
    <section aria-label={`Video: ${note.title}`} class="note-video-section">
      <div class="note-video-frame">
        <iframe src={embedUrl} title={`Video: ${note.title}`} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
      <p class="note-video-fallback">Si el reproductor no está disponible, <a href={watchUrl}>abre “{note.title}” directamente en YouTube</a>.</p>
    </section>
  )}
  <template data-code-copy-content>
    <Copy aria-hidden="true" class="ui-icon" />
    <span>Copiar</span>
  </template>
</article>

<script>
  const noteProse = document.querySelector<HTMLElement>('.note-prose');
  const imageDialog = document.querySelector<HTMLDialogElement>('[data-note-image-dialog]');
  const dialogImage = imageDialog?.querySelector<HTMLImageElement>('[data-note-image-preview]');
  const dialogCaption = imageDialog?.querySelector<HTMLElement>('[data-note-image-caption]');
  const dialogCloseButton = imageDialog?.querySelector<HTMLButtonElement>('[data-note-image-close]');
  const codeCopyContent = document.querySelector<HTMLTemplateElement>('[data-code-copy-content]');
  let imageTriggerToRestore: HTMLButtonElement | null = null;

  noteProse?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
  });

  const closeImageDialog = (): void => {
    imageDialog?.close();
  };

  const openImageDialog = (image: HTMLImageElement, trigger: HTMLButtonElement): void => {
    if (!imageDialog || !dialogImage || !dialogCaption) return;

    const description = image.alt.trim();
    imageTriggerToRestore = trigger;
    dialogImage.src = image.currentSrc || image.src;
    dialogImage.alt = description;
    dialogCaption.textContent = description;
    dialogCaption.hidden = description.length === 0;
    document.documentElement.classList.add('has-open-dialog');
    imageDialog.showModal();
    dialogCloseButton?.focus();
  };

  noteProse?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
    if (image.closest('a, button, [role="button"]')) return;

    const trigger = document.createElement('button');
    const description = image.alt.trim();
    trigger.type = 'button';
    trigger.className = 'note-image-trigger';
    trigger.setAttribute('aria-label', description ? `Ampliar imagen: ${description}` : 'Ampliar imagen');
    image.before(trigger);
    trigger.append(image);
    trigger.addEventListener('click', () => openImageDialog(image, trigger));
  });

  dialogCloseButton?.addEventListener('click', closeImageDialog);
  imageDialog?.addEventListener('click', (event) => {
    if (event.target === imageDialog) closeImageDialog();
  });
  imageDialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('has-open-dialog');
    dialogImage?.removeAttribute('src');
    imageTriggerToRestore?.focus();
    imageTriggerToRestore = null;
  });

  const selectCodeForManualCopy = (code: HTMLElement): void => {
    const selection = window.getSelection();
    if (!selection) return;

    const range = document.createRange();
    range.selectNodeContents(code);
    selection.removeAllRanges();
    selection.addRange(range);
  };

  const enhanceCodeBlock = (code: HTMLElement): void => {
    const preformattedBlock = code.parentElement;
    if (!(preformattedBlock instanceof HTMLPreElement) || preformattedBlock.parentElement?.classList.contains('code-block')) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const button = document.createElement('button');
    button.className = 'code-copy-button';
    button.type = 'button';
    if (codeCopyContent) button.append(codeCopyContent.content.cloneNode(true));
    else button.textContent = 'Copiar';
    button.setAttribute('aria-label', 'Copiar bloque de código');
    const status = document.createElement('p');
    status.className = 'code-copy-status';
    status.setAttribute('aria-live', 'polite');

    preformattedBlock.before(wrapper);
    wrapper.append(button, status, preformattedBlock);

    let resetTimer: number | undefined;
    const showStatus = (message: string, state: 'copied' | 'error'): void => {
      window.clearTimeout(resetTimer);
      wrapper.dataset.copyState = state;
      status.textContent = message;
      if (state === 'copied') {
        resetTimer = window.setTimeout(() => {
          wrapper.dataset.copyState = 'idle';
          status.textContent = '';
        }, 2400);
      }
    };

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(code.textContent ?? '');
        showStatus('Código copiado.', 'copied');
      } catch {
        selectCodeForManualCopy(code);
        showStatus('No se pudo copiar automáticamente. El código quedó seleccionado para copiarlo manualmente.', 'error');
      }
    });
  };

  noteProse?.querySelectorAll<HTMLElement>('pre > code').forEach(enhanceCodeBlock);
</script>
