---
import ThemeSelector from '@components/ThemeSelector.astro';
---

<header class="site-header">
  <div class="shell flex min-h-18 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4">
    <a href="/" class="inline-flex min-h-11 items-center gap-3 rounded-lg font-bold no-underline">
      <span aria-hidden="true" class="brand-mark grid size-9 place-items-center rounded-xl bg-accent">∴</span>
      <span>Learn with Me</span>
    </a>
    <nav aria-label="Navegación principal" class="flex w-full items-center justify-between gap-3 sm:w-auto sm:justify-end">
      <a class="category-nav-link inline-flex min-h-11 items-center rounded-full border border-line px-4 font-semibold no-underline hover:border-accent hover:text-accent" href="/categorias/">Categorías</a>
      <ThemeSelector />
    </nav>
