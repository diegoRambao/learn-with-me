---
import type { SocialLink } from '@data/site';
interface Props { links: ReadonlyArray<SocialLink> }
const { links } = Astro.props;
---

{links.length > 0 && (
  <section aria-labelledby="redes" class="mt-16">
    <h2 id="redes" class="text-xl font-bold">Continúa la conversación</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {links.map((link) => <li><a class="inline-flex min-h-11 items-center rounded-full border border-line px-5 font-semibold no-underline hover:border-accent hover:text-accent" href={link.url}>{link.label}</a></li>)}
    </ul>
  </section>
)}

