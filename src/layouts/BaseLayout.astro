---
import SiteHeader from '@components/SiteHeader.astro';
import { themePreferences, themeStorageKey } from '@lib/theme';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Learn with Me',
  description = 'Apuntes personales sobre los temas que voy estudiando, abiertos para consultar, estudiar y compartir.',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="system">
  <head>
    <script is:inline define:vars={{ themePreferences, themeStorageKey }}>
      try {
        const savedTheme = localStorage.getItem(themeStorageKey);
        if (themePreferences.includes(savedTheme)) document.documentElement.dataset.theme = savedTheme;
      } catch {
        document.documentElement.dataset.theme = 'system';
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer class="shell mt-24 border-t border-line py-10 text-sm text-muted">
      <p>Apuntes para pensar, consultar y volver a mirar.</p>
    </footer>
  </body>
</html>
