---
import { getCollection, render } from 'astro:content';
import CourseNavigation from '@components/CourseNavigation.astro';
import NoteContent from '@components/NoteContent.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categoryFromEntry, createLearningRoute, noteFromEntry } from '@lib/content';

export async function getStaticPaths() {
  const [categories, notes] = await Promise.all([getCollection('categories'), getCollection('notes')]);
  return notes.flatMap((note) => {
    const category = categories.find(({ id }) => id === note.data.category);
    return category ? [{ params: { categoryId: category.id, noteId: note.id }, props: { category, note } }] : [];
  });
}

const { category: categoryEntry, note: noteEntry } = Astro.props;
const category = categoryFromEntry(categoryEntry);
const entries = await getCollection('notes');
const notes = entries.map(noteFromEntry);
const route = createLearningRoute(category, notes, noteEntry.id);
const note = route.activeNote;
if (!note) return Astro.redirect('/categorias/?notice=invalid-note-context');
const { Content } = await render(noteEntry);
---

<BaseLayout title={`${note.title} · ${category.name}`} description={note.description}>
  <div class="shell pt-8 sm:pt-12">
    <a href="/categorias/" class="text-sm font-bold text-accent no-underline">← Todas las categorías</a>
    <div class="mt-8 grid gap-8 lg:grid-cols-[19rem_minmax(0,1fr)] lg:items-start">
      <CourseNavigation category={category} notes={route.notes} activeNoteId={note.id} />
      <div class="min-w-0 lg:px-6"><NoteContent note={note} Content={Content} /></div>
    </div>
  </div>
</BaseLayout>

