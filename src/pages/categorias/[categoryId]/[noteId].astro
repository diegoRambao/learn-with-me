---
import { ArrowLeft, PanelLeftClose, PanelLeftOpen } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import CourseNavigation from '@components/CourseNavigation.astro';
import NoteContent from '@components/NoteContent.astro';
import NoteNavigation from '@components/NoteNavigation.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categoryFromEntry, createLearningRoute, noteFromEntry } from '@lib/content';
import { noteIdFromEntryId } from '@lib/note-path';

export async function getStaticPaths() {
  const [categories, notes] = await Promise.all([getCollection('categories'), getCollection('notes')]);
  return notes.flatMap((noteEntry) => {
    const category = categories.find(({ id }) => id === noteEntry.data.category);
    const note = noteFromEntry(noteEntry);
    return category ? [{ params: { categoryId: category.id, noteId: note.id }, props: { category, note: noteEntry } }] : [];
  });
}

const { category: categoryEntry, note: noteEntry } = Astro.props;
const category = categoryFromEntry(categoryEntry);
const entries = await getCollection('notes');
const notes = entries.map(noteFromEntry);
const route = createLearningRoute(category, notes, noteIdFromEntryId(noteEntry.id));
const note = route.activeNote;
if (!note) return Astro.redirect('/categorias/?notice=invalid-note-context');
const { Content } = await render(noteEntry);
---

<BaseLayout title={`${note.title} · ${category.name}`} description={note.description}>
  <div class="shell pt-8 sm:pt-12">
    <a href="/categorias/" class="inline-flex items-center gap-2 text-sm font-bold text-accent no-underline"><ArrowLeft aria-hidden="true" class="ui-icon" />Todas las categorías</a>
    <button type="button" class="sidebar-toggle" aria-controls="course-navigation-panel" aria-expanded="true" data-sidebar-toggle>
      <PanelLeftClose aria-hidden="true" class="ui-icon" data-sidebar-icon="hide" />
      <PanelLeftOpen aria-hidden="true" class="ui-icon is-hidden" data-sidebar-icon="show" />
      <span data-sidebar-toggle-label>Ocultar panel</span>
    </button>
    <div class="note-workspace mt-4" data-note-workspace data-sidebar-visible="true">
      <aside id="course-navigation-panel" class="course-navigation-panel panel" aria-label={`Ruta: ${category.name}`}>
        <CourseNavigation category={category} navigationItems={route.navigationItems} activeNoteId={note.id} activeTopicId={route.activeTopicId} />
      </aside>
      <div class="note-workspace-content min-w-0 lg:px-6">
        <NoteContent note={note} Content={Content} />
        <NoteNavigation category={route.category} previousNote={route.previousNote} nextNote={route.nextNote} />
      </div>
    </div>
  </div>
</BaseLayout>
