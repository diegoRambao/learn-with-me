---
import { getCollection } from 'astro:content';
import EmptyState from '@components/EmptyState.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categoryFromEntry, createLearningRoute, noteFromEntry } from '@lib/content';
import { noteUrl } from '@lib/routes';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({ params: { categoryId: category.id }, props: { category } }));
}

const { category: categoryEntry } = Astro.props;
const category = categoryFromEntry(categoryEntry);
const notes = (await getCollection('notes')).map(noteFromEntry);
const route = createLearningRoute(category, notes);
const initialNoteUrl = route.activeNote ? noteUrl(category.id, route.activeNote.id) : null;
if (initialNoteUrl) return Astro.redirect(initialNoteUrl);
---

<BaseLayout title={`${category.name} · Aprender con propósito`}>
  <div class="shell pt-12">
    <a href="/categorias/" class="text-sm font-bold text-accent no-underline">← Todas las categorías</a>
    <p class="eyebrow mt-10">Ruta de aprendizaje</p>
    <h1 class="mt-4 text-4xl font-bold">{category.name}</h1>
    <div class="mt-10"><EmptyState kind="route" /></div>
  </div>
</BaseLayout>
