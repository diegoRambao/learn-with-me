---
import { getCollection } from 'astro:content';
import CategoryCard from '@components/CategoryCard.astro';
import CategoryFilters from '@components/CategoryFilters.astro';
import EmptyState from '@components/EmptyState.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categoryFromEntry, createHomeCategoryIndex, noteFromEntry } from '@lib/content';
import { categoryDestination } from '@lib/routes';

const categories = createHomeCategoryIndex((await getCollection('categories')).map(categoryFromEntry)).categories;
const notes = (await getCollection('notes')).map(noteFromEntry);
---

<BaseLayout title="Categorías · Learn with Me" description="Explora rutas de aprendizaje y elige una categoría según tu nivel.">
  <div class="shell pt-12 sm:pt-18">
    <header class="max-w-3xl">
      <p class="eyebrow">Rutas de aprendizaje</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-6xl">Elige el próximo tema que quieres comprender.</h1>
      <p class="mt-6 text-lg leading-8 text-muted">Cada categoría reúne notas en un orden pensado para avanzar con contexto, desde los fundamentos hasta la práctica.</p>
    </header>

    <aside data-invalid-notice hidden class="notice mt-10 rounded-xl border p-5" role="status">
      <div class="flex items-start justify-between gap-5">
        <p>No pudimos abrir esa nota porque la categoría no es válida. Elige una categoría para continuar.</p>
        <button type="button" data-dismiss-notice class="notice-dismiss min-h-8 shrink-0 rounded-lg px-2 font-bold" aria-label="Descartar aviso">×</button>
      </div>
    </aside>

    {categories.length > 0 ? (
      <>
        <div class="mt-12"><CategoryFilters total={categories.length} /></div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-category-grid>
          {categories.map((category) => <CategoryCard category={category} destination={categoryDestination(category.id, notes)} />)}
        </div>
        <div class="mt-8"><EmptyState kind="matches" /></div>
      </>
    ) : <div class="mt-12"><EmptyState kind="categories" /></div>}
  </div>
</BaseLayout>

<script>
  const parameters = new URLSearchParams(window.location.search);
  if (parameters.get('notice') === 'invalid-note-context') {
    const notice = document.querySelector<HTMLElement>('[data-invalid-notice]');
    if (notice) notice.hidden = false;
    document.querySelector('[data-dismiss-notice]')?.addEventListener('click', () => {
      if (notice) notice.hidden = true;
      history.replaceState(null, '', '/categorias/');
    });
  }
</script>
